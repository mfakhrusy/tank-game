{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tank-game-mfakhrusy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/builds", "/api/builds/*"]
  },
  "d1_databases": [{
    "binding": "BUILD_DB",
    "database_name": "tank-game-builds",
    "database_id": "cae0082e-0f46-46ae-aabb-8f1a7e71761d",
    "migrations_dir": "migrations"
  }]
}
