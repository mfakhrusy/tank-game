{
  "name": "snap-tank-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "check": "npm run test && npm run test:rust && npm run lint:rust && npm run build && npm run test:e2e",
    "deploy:cloudflare": "npm run build && wrangler deploy --config wrangler.frontend.jsonc",
    "lint:rust": "cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path backend/Cargo.toml --locked",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:sharing": "wrangler d1 migrations apply BUILD_DB --local --config wrangler.frontend.jsonc && wrangler dev --config wrangler.frontend.jsonc --port 8788"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "phaser": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "undici": "^7.29.0",
    "vitest": "latest",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
