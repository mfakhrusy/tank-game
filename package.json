{
  "name": "snap-tank-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "check": "npm run format:check && npm run lint && npm run test && npm run test:rust && npm run lint:rust && npm run build && npm run test:e2e",
    "deploy:cloudflare": "npm run build && wrangler deploy --config wrangler.frontend.jsonc",
    "lint:rust": "cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path backend/Cargo.toml --locked",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:sharing": "wrangler d1 migrations apply BUILD_DB --local --config wrangler.frontend.jsonc && wrangler dev --config wrangler.frontend.jsonc --port 8788",
    "format": "oxfmt --write . && npm run format:rust",
    "format:check": "oxfmt --check . && npm run format:rust:check",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format:rust": "cargo fmt --manifest-path backend/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path backend/Cargo.toml -- --check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "phaser": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "undici": "^7.29.0",
    "vitest": "latest",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
