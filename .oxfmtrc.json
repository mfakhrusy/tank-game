{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "trailingComma": "all",
  "ignorePatterns": [
    "backend/**",
    "dist/**",
    "node_modules/**",
    ".wrangler/**",
    "test-results/**",
    "playwright-report/**",
    "worker/worker-configuration.d.ts",
    "package-lock.json",
    "wrangler.jsonc"
  ]
}
